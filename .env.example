# =============================================================
# Adra-AI — Production Environment Variables
# Copy this file to .env on your Droplet and fill in real values.
# NEVER commit .env to git.
# =============================================================

# ----- Database -----
# Heroku Postgres addon sets this automatically (as postgres://, normalized in code).
# For local development: use your local Postgres connection string.
DATABASE_URL=postgresql+asyncpg://adrai:adrai_password@localhost:5433/adrai
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ----- Qdrant Vector DB -----
# Qdrant Cloud cluster URL and API key (from the Qdrant Cloud console)
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ----- Security -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ----- Google OAuth -----
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ----- GitHub OAuth -----
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# ----- URLs -----
# FRONTEND_URL: your Vercel deployment URL (used as the default CORS origin and OAuth redirects)
FRONTEND_URL=https://your-app.vercel.app
# ALLOWED_ORIGINS: comma-separated list of allowed CORS origins. Takes precedence over FRONTEND_URL.
# ALLOWED_ORIGINS=https://your-app.vercel.app
# NEXT_PUBLIC_API_URL: your Heroku app's URL (used by the frontend)
NEXT_PUBLIC_API_URL=https://your-app.herokuapp.com

# ----- Frontend OAuth (used by Vercel, not the backend) -----
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id

# ----- LLM / AI -----
# Choose your LLM provider: gemini (default), groq, or nvidia
LLM_PROVIDER=gemini
GROQ_API_KEY=your-groq-api-key
# Optional: a separate Groq key (another account) that only the eval harness uses, so evals never drain the app's daily quota
GROQ_API_KEY_TEST=
# Optional: a Google key (another project) used only by the evals: embeddings + the judge
GOOGLE_API_KEY_TEST=
GOOGLE_API_KEY=your-google-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# ----- Rate limit tuning -----
LLM_MIN_INTERVAL_SEC=2.5
LLM_MAX_RETRIES=5
LLM_RATE_LIMIT_RETRIES=3          # times a 429 is waited out (provider's retry hint, else 5s/10s/20s)
LLM_RATE_LIMIT_MAX_WAIT_SEC=60    # a longer hint (e.g. a daily quota) is raised immediately
EMBED_RATE_LIMIT_RETRIES=5        # same for embedding calls (indexing makes one per chunk)
EMBED_RATE_LIMIT_MAX_WAIT_SEC=60

# Online evals (§2.5): the LLM judge grades a sample of real runs plus every thumbs-down (admin page /admin/evals)
ONLINE_EVAL_SAMPLE_RATE=0.1          # share of successful runs graded; 0 turns sampling off
ONLINE_EVAL_ON_THUMBS_DOWN=true      # also grade every reply a user rates thumbs-down

# Guardrails (§3.1): per-user limits on agent requests (chat questions, edits, new projects) and request size
GENERATION_LIMIT_PER_HOUR=20          # 0 = no hourly limit
GENERATION_LIMIT_PER_DAY=40           # 0 = no daily limit
MAX_PROMPT_CHARS=8000
# EVAL_JUDGE_MODEL=gemini-3.5-flash-lite   # the judge (uses GOOGLE_API_KEY; that project must allow this model)
LLM_MAX_CONTENT_CHARS=10000

# ----- Admin Access -----
# Comma-separated list of emails that bypass usage quotas
ADMIN_EMAILS=admin@example.com

# ----- LangSmith (for tracing/debugging) -----
# LANGSMITH_TRACING_V2=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=Adra AI

# ----- Langfuse (for tracing/debugging - runs alongside LangSmith) -----
# Both public + secret key must be set for Langfuse tracing to activate;
# leave unset to keep running LangSmith only. Free Langfuse Cloud account:
# https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
